
# PostgreSQL
DATABASE_URL=
DATABASE_SSL=true
DATABASE_POOL_MAX=10

# WhatsApp Cloud API
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# Temporary inventory values — replace with actual room counts
ROOM_INVENTORY_JSON={"Suit Plus Room":15,"Double Room":15,"Single Deluxe Room":15,"Twin Room":15,"Executive Room":15,"Suit Room":15}

# Shared secret required by GET /api/bookings/:reference only (looks up a
# guest's name/phone/email by reference, so it must not be public). The
# public booking form's own calls — GET /availability and POST / — do not
# need this and are unaffected. Generate one long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
BOOKINGS_API_KEY=
